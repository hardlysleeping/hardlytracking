{
  "name": "hardlytracking",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/unit/register-ts.mjs --test tests/unit/*.test.mjs",
    "smoke": "node --experimental-strip-types --import ./tests/unit/register-ts.mjs scripts/smoke.mjs",
    "serve": "node server/proxy.mjs",
    "matrix:check": "node --experimental-strip-types --import ./tests/unit/register-ts.mjs scripts/matrix-check.mjs",
    "sync:roundtrip": "node --experimental-strip-types --import ./tests/unit/register-ts.mjs scripts/sync-roundtrip.mjs",
    "dalvik:smoke": "node --experimental-strip-types --import ./tests/unit/register-ts.mjs scripts/dalvik-smoke.mjs",
    "serve:lan": "HOST=0.0.0.0 node server/proxy.mjs",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "desktop": "node scripts/prepare-runtime.mjs && tauri build",
    "perf": "node --experimental-strip-types --import ./tests/unit/register-ts.mjs scripts/library-perf.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@supabase/supabase-js": "^2.118.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "mihon-runtime": "file:plugins/mihon-runtime"
  }
}
