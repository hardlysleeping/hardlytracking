{
  "manifestVersion": 1,
  "id": "dev.hardlytracking.reader-tools",
  "name": "Reader Tools",
  "version": "1.0.0",
  "apiVersion": 1,
  "minAppVersion": "0.5.8",
  "entry": "entry.js",
  "permissions": ["library.read", "plugin.storage", "ui.series"],
  "networkHosts": [],
  "description": "Adds a Show Extra Info entry to a series page, and remembers what you asked for last time.",
  "contributes": {
    "seriesActions": [{ "id": "show-info", "title": "Show Extra Info" }]
  }
}
