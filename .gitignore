node_modules/
dist/
dist.orphan-*/
.DS_Store
*.log
.vite/

# Environment: public values only (the anon key ships in every bundle by design), but a file that
# holds them is still not source. Never the service_role key — that one bypasses row-level security.
.env
.env.local

# working notes: private, never published (same rule as HardlyReader)
BACKLOG.md

# iOS shell: generated by `cap sync`, rebuilt in CI, never committed.
ios/App/Pods/
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/App.xcworkspace/
ios/DerivedData/
*.ipa

# The embedded runtime: downloaded and linked by the pod's prepare_command on the Mac that builds the
# app (pinned by SHA-256 in plugins/mihon-runtime/ios/PrepareEmbeddedRuntime.sh). Never committed —
# it is hundreds of megabytes of someone else's binary.
plugins/mihon-runtime/ios/Frameworks/
plugins/mihon-runtime/ios/Runtime/

# a worktree symlink, never part of the tree
node_modules
dist-bench/

# The desktop extension host jar: a 100 MB build output, downloaded or copied in, never committed.
plugins/mihon-runtime/linux/*.jar
# `scripts/prepare-runtime.mjs` unpacks the pinned M-Extension-Server release (jar + JRE) here; both
# are downloaded artefacts and both are ~100 MB.
src-tauri/runtime/
plugins/mihon-runtime/cache/

# The HT-Server's extension registry (data/host-extensions.json + the APKs beside it). Machine state:
# a list of what this PC installed, never source.
data/

# Rust build output: 6 GB of object files, never source.
src-tauri/target/
